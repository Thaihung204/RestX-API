{
  "ReverseProxy": {
    "Routes": {
      "admin-route": {
        "ClusterId": "admin-cluster",
        "Match": {
          "Hosts": [ "admin.restx.food" ],
          "Path": "/{**catch-all}"
        }
      },
      "api-route": {
        "ClusterId": "webapp-cluster",
        "Match": {
          "Hosts": [ "api.restx.food" ],
          "Path": "/api/{**catch-all}"
        }
      },
      "webapp-root": {
        "ClusterId": "webapp-cluster",
        "Match": {
          "Hosts": [ "restx.food" ],
          "Path": "/{**catch-all}"
        }
      },
      "webapp-sub": {
        "ClusterId": "webapp-cluster",
        "Match": {
          "Hosts": [ "{**sub}.restx.food" ],
          "Path": "/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "admin-cluster": {
        "Destinations": {
          "admin": {
            "Address": "http://admin:4999/"
          }
        }
      },
      "webapp-cluster": {
        "Destinations": {
          "web": {
            "Address": "http://web:5000/"
          }
        }
      }
    }
  }
}
  